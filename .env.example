VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
VITE_AUTH_REDIRECT_URL=https://your-domain.example

GEMINI_API_KEY=your-server-only-gemini-key
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional fallback providers, tried in order when Gemini fails.
# Groq Vision is only used when a request depends on reading an attached image
# or a scanned PDF, so the fallback chain keeps working for file uploads.
GROQ_API_KEY=your-server-only-groq-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-90b-vision-instruct

OPENROUTER_API_KEY=your-server-only-openrouter-key
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
