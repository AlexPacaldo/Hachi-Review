VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
VITE_AUTH_REDIRECT_URL=https://your-domain.example

# Read by the serverless function to verify the caller's session. Falls back to the
# VITE_ values above, so set these only if you want them kept apart.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# Server only. Never prefix these with VITE_ or they get inlined into the bundle
# and handed to every visitor.
GEMINI_API_KEY=your-server-only-gemini-key
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional fallback providers, tried in order when Gemini fails.
# Groq Vision is only used when a request depends on reading an attached image
# or a scanned PDF, so the fallback chain keeps working for file uploads.
GROQ_API_KEY=your-server-only-groq-key
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

OPENROUTER_API_KEY=your-server-only-openrouter-key
OPENROUTER_MODEL=qwen/qwen2.5-vl-72b-instruct:free

# How long a single provider call may take before the chain moves on.
AI_PROVIDER_TIMEOUT_MS=90000

# AI quota protection. Requests allowed per signed-in account per 10 minutes.
# Generation requires a sign-in: the keys are free tier, so abuse costs quota
# rather than money, and a per-address cap cannot protect that because an address
# is not an identity.
AI_RATE_LIMIT_MAX_REQUESTS=8

# A full generation legitimately makes about five upstream calls (the initial pass,
# three top-ups, and the choice-rebalance pass), so the call budget below is sized
# to stay out of the way. It is a runaway guard, not a quality setting: lower it
# only if a provider is misbehaving, never to shorten output.
AI_UPSTREAM_CALL_BUDGET=12
